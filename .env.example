NODE_ENV=development
BIND_HOST=127.0.0.1
PORT=4010
DATA_DIR=./data
SESSION_SECRET=replace-with-at-least-32-random-characters
TRADING_MODE=SIMULATION
ALLOW_LIVE_TRADING=false
LOG_LEVEL=info
CODEX_BIN=codex
CODEX_TIMEOUT_MS=120000
CODEX_MAX_CONCURRENCY=1
WEB_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ROBINHOOD_AGENTIC_ACCOUNT_ID=
APP_GIT_SHA=unrecorded
# Pre-production networking / optional notification connector
PRIVATE_UI_URL=
# Set PRIVATE_UI_URL to the same private HTTPS tailnet origin as WEB_ORIGIN.
ENABLE_SMS_DELIVERY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=
# Reviewed, protected JSON contract mapping for authenticated READ_ONLY MCP.
ROBINHOOD_BINDING_FILE=
