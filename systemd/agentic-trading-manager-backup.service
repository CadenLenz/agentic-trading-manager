[Unit]
Description=Back up Agentic Trading Manager SQLite database
ConditionPathExists=/var/lib/agentic-trading-manager/agentic-trading-manager.db

[Service]
Type=oneshot
User=agentic-trader
Group=agentic-trader
WorkingDirectory=/opt/agentic-trading-manager/current
EnvironmentFile=/etc/agentic-trading-manager/agentic-trading-manager.env
Environment=BACKUP_DIR=/var/backups/agentic-trading-manager
ExecStart=/usr/bin/npm run backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentic-trading-manager /var/backups/agentic-trading-manager
